# ==============================================================
# VaultFlow - Single-User Personal Finance Configuration
# ==============================================================

# Single-user Master PIN code (6 digits recommended)
VERCEL_APP_PIN=123456

# Session cookie HMAC encryption secret (generate 32+ characters)
AUTH_SECRET=vaultflow-ultra-secure-random-secret-key-32-chars

# Turso Database Configuration (libSQL Serverless)
# Leave empty for local development (will fallback to local SQLite file:local.db)
# For production, obtain from Turso CLI ("turso db show <name> --url" and "turso db tokens create <name>")
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
